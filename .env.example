# Copie para .env (ignorado pelo git) e preencha o que for usar.
#
# Nada aqui é obrigatório para rodar o projeto: importar PDF do Inter e da B3,
# categorizar e abrir o dashboard funcionam sem nenhuma credencial. Só a
# sincronização com o Mercado Pago precisa de token.

# Token de PRODUÇÃO do Mercado Pago.
# Onde pegar: mercadopago.com.br/developers -> Suas integrações -> Credenciais
# de produção. Dá acesso de leitura ao histórico de pagamentos da conta —
# trate como senha, nunca coloque em código nem em print/captura de tela.
MP_ACCESS_TOKEN=

# Só necessários quando houver fluxo OAuth (client id/secret) ou checkout no
# navegador (public key). O projeto hoje não usa nenhum dos três.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_PUBLIC_KEY=

# Caminho do banco SQLite. Padrão: fin.db ao lado do código.
# FIN_DB=

# Endereço e porta do dashboard. Padrão: 127.0.0.1:8000 (só esta máquina).
# Trocar o host expõe seu extrato bancário na rede — o dashboard não tem login.
# FIN_HOST=127.0.0.1
# FIN_PORT=8000
